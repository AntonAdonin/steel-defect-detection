# MLflow Configuration
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_MODEL_NAME=steel_defect_ensemble
MLFLOW_MODEL_STAGE=Staging

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_TITLE=Steel Defect Detection API
API_VERSION=1.0.0

# Kaggle API (for dataset download)
# Place your kaggle.json in ~/.kaggle/kaggle.json
# Or set these environment variables:
# KAGGLE_USERNAME=your_username
# KAGGLE_KEY=your_key

# Python Environment
PYTHONPATH=.

# DVC Remote Storage (optional)
# DVC_REMOTE_URL=s3://your-bucket/dvcstore
# DVC_REMOTE_URL=gs://your-bucket/dvcstore
# DVC_REMOTE_URL=azure://your-container/path
